{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trigenys Claude Accounts Manager",
  "version": "0.1.0",
  "identifier": "com.trigenys.claudeaccounts",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trigenys Claude Accounts Manager",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "center": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}